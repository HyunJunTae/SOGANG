            ("mlflow", dockerfile_mlflow),
            ("pipeline", dockerfile_pipeline),
            ("dashboard", dockerfile_dashboard),
        ]:
            assert "python:3.10" in content, (
                f"{name} Dockerfile must use Python 3.10"
            )

